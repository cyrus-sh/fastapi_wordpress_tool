APP_NAME=AI Sales Agent API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# MySQL / WordPress
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_wordpress_user
MYSQL_PASSWORD=your_secure_password
MYSQL_DB=wordpress
WP_TABLE_PREFIX=wp_

# LLM Provider Options: gemini, openai, deepseek, openai_compatible
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
GEMINI_MODEL=gemini-2.5-flash

# LLM API Keys (use only the one for your selected provider)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_BASE_URL=your_base_url_here
OPENAI_COMPATIBLE_API_KEY=your_api_key_here

# Embeddings
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Checkout URL on WordPress side
WP_CHECKOUT_BASE_URL=https://your-domain.com/checkout
